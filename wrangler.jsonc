{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clutch-unity-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "secrets": {
    "required": [
      "CLUTCH_SERVER_KEY"
    ]
  }
}